# Copy to .env and fill in. .env is gitignored.

# Accounts and database: public project URL and publishable key (legacy anon key also works).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# The frontend and email-confirmation/reset destination. Match Supabase Auth redirect settings.
PUBLIC_APP_URL=http://localhost:5173
# Generate locally with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Server-only encryption key. Keep stable and backed up; losing it makes saved books/bank tokens unreadable.
APP_DATA_KEY=
# Set true for HTTPS deployments. Never set service-role credentials in frontend code.
COOKIE_SECURE=false

# "anthropic" (default) or "bedrock"
MODEL_PROVIDER=anthropic

# --- Anthropic API ---
ANTHROPIC_API_KEY=

# Models (defaults shown). The CFO combines reports; specialists just call tools.
CFO_MODEL_ID=claude-sonnet-5-5
SPECIALIST_MODEL_ID=claude-haiku-5-5

# --- Amazon Bedrock (optional) ---
# Needs AWS credentials and Claude model access enabled in the Bedrock console.
# With bedrock, set CFO_MODEL_ID / SPECIALIST_MODEL_ID to Bedrock IDs, e.g.
# global.anthropic.claude-sonnet-5-5 (these are the defaults when MODEL_PROVIDER=bedrock).
AWS_REGION=us-west-2

# --- Plaid bank connections (optional) ---
# Free sandbox keys: dashboard.plaid.com > Developers > Keys
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Filled in by: python scripts/create_plaid_sandbox_bank.py
PLAID_SANDBOX_ACCESS_TOKEN=
PLAID_SANDBOX_ITEM_ID=
